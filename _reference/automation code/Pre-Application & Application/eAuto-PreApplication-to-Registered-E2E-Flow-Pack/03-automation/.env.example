# Run settings for EAINT-11982. Copy to .env and fill in.
#
# CREDENTIALS DO NOT BELONG HERE. Passwords live in exactly one file:
#   C:\Users\<you>\.claude\secrets\eauto.env
# A second copy is worse than a leak — when the two drift, whichever one the
# code happens to read is the one that decides, so one of them is silently a lie.
# Every _PASS in this template stays blank, on purpose.

# --- environment -------------------------------------------------------------
EAUTO_BASE=https://staging.eauto.my
EAUTO_INSTANCE=uat4

# --- who plays which part (keys from the shared store, not passwords) --------
# The 23-08-2026 walkthrough used jasons as approver and BOChar as assignee.
EV_APPROVER=ops_jasons
EV_ASSIGNEE=hubadmin_bochar

# --- fixtures ----------------------------------------------------------------
# Read-only gating checks run against this one.
APP_NO=

# Destructive. Each run spends the application's ONE extension (R1), so this
# must be a fresh application every time — never the same one as APP_NO.
EXTEND_APP_NO=

# Already past its expiry but inside the 3-month window, for TS05.
EXPIRED_APP_NO=

# TS01.8 — an application that was extended ONCE and then taken to Registered
# through Create Account. Terminal: creating the account destroys the fixture,
# and the Hardcopy dropdown cannot get there on its own (Pending UCD /
# Incomplete Docs / Pending Assignee only). Do it to a fixture the grand tour
# has already finished with, then paste the number here.
EXTENDED_REGISTERED_APP_NO=

# TS15 — the application the REQ-004 account sweep looks at. Any eligible
# record will do (Approved, Hardcopy ≠ Registered, never extended, and it must
# have a Registration Documents page). Read-only: every account only LOOKS at
# the button, so this can safely be APP_NO. Falls back to APP_NO/EXTEND_APP_NO
# when blank. The eighteen blocked usernames are in the spec, not here — they
# are a requirement (REQ-004), not a run setting.
ROLES_APP_NO=

# Remark written by the automated extension.
EXTEND_REMARK=QA EAINT-11982 — automated extension check

# --- fixture builder (scripts/build-fixture.js) -------------------------------
# The UCD Group the assignee sets before Submit for Approval. Left blank, the
# builder takes the first option — fine for a fixture, wrong for a test that
# asserts on grouping.
EV_UCD_GROUP=

# Prefix for the generated Admin In Charge address. The builder appends
# +<run-stamp> so every dealer has its own inbox and none of them collide.
EV_FIXTURE_EMAIL_PREFIX=qa.eaint11982

# Set to 1 for unattended runs: a missing locator then FAILS instead of waiting
# for someone to finish the field by hand. Leave blank for assisted runs.
EV_NO_PROMPT=

# How long a payment step waits for a human at the gateway, in milliseconds.
# Default 1800000 (30 minutes). Ten minutes proved too short — the operator has
# to log in to online banking, which is not a ten-second task. Set it low only
# for an unattended run that should fail fast rather than hang.
EV_PAY_WAIT_MS=

# --- TS48: the Probation role gate (tests/extend-roles.spec.js) ---------------
# TS48 proves a Probation account can reach neither the application page nor the
# Extend button. QA has no Probation login and 47 staging accounts hold the role,
# so the only way to test it is to switch a SHARED account's role and put it back
# — which is why it is opted into explicitly and never rides `npm run test:roles`.
#
#   EV_ALLOW_ROLE_SWITCH=1 ROLES_APP_NO=NA68001099 npx playwright test extend-roles --grep TS48
#
# Leave BLANK unless you mean it. src/boRoles.js restores the account in a
# finally and TS48 asserts the restore, but a run killed mid-flight can still
# leave BOChar on Probation and break everyone else's suite.
EV_ALLOW_ROLE_SWITCH=

# Who gets switched, who does the switching, and under which company. Defaults
# below are what the code uses when these are blank. BOChar's home role is
# HubAdmin; `BOChar1` is a DIFFERENT account that already sits on Probation, so
# never abbreviate the login id.
ROLE_SWITCH_SUBJECT=
ROLE_SWITCH_KEY=
ROLE_SWITCHER=
ROLE_SWITCH_COMPANY=

# --- the eAuto support tool: reset application expiry -------------------------
# http://172.30.202.23:8888/eauto-support/obs/reset-expiry — type an application
# trx no and an expiry date, and the record's expiry becomes that date. This is
# the answer to Q12, which is what filed TS08.4/.5, TS09 and TS22 as BLOCKED.
#
# THE VPN IS NOT OPTIONAL. That host is a private address; off VPN it does not
# exist. Every entry point TCP-probes it first (src/vpn.js) because Playwright's
# own diagnosis of an unroutable host reads as a slow server, and behind a captive
# DNS it reads as a MISSING FORM — a bug report against a page we never reached.
# Connect FortiClient VPN, then run. Off-VPN exits with code 2, not 1.
SUPPORT_BASE=http://172.30.202.23:8888
SUPPORT_RESET_EXPIRY_PATH=/eauto-support/obs/reset-expiry

# THE TOOL IS BEHIND ITS OWN SIGN-IN (found on the first connected run, 26-08-2026).
# /obs/reset-expiry answers 302 -> /eauto-support/login, a Spring Security form
# belonging to a SEPARATE application: "eAuto Support Portal - Internal Developer
# Support Platform", footer "Internal use only. Contact IT Support for access".
# An eAuto BackOffice session does not open it.
#
# The credential goes in the SHARED STORE, never here. Two ways, never both —
# a second copy of a password drifts, and then whichever the code reads decides:
#
#   SUPPORT_ACCOUNT=ops_jasons     # the portal accepts an existing eAuto login
#   SUPPORT_USER / SUPPORT_PASS    # the portal has its own user list
#
# The form offers "Remember me for 7 days"; the harness ticks it and saves the
# cookie jar to .auth/support.json, so signing in is about weekly, not per run.
SUPPORT_LOGIN_PATH=/eauto-support/login

# The application whose expiry tests/extend-expiry-patch.spec.js moves around.
# Must be Approved, never extended, Hardcopy Doc not Registered, and it must have
# a Registration Documents page. Deliberately NOT defaulted to APP_NO: that
# fixture's C2 test asserts "expiry is created + 90 days", and leaving it patched
# would fail in another file in a way that reads as a product defect.
SUPPORT_APP_NO=

# Opt-in for the patch suite, same reasoning as EV_ALLOW_ROLE_SWITCH: it mutates
# a record on shared staging that someone else's run may be using. Blank = the
# suite skips.
EV_ALLOW_EXPIRY_PATCH=

# --- pinning the support form: NO LONGER NEEDED (26-08-2026) ------------------
# The tool has now been read live. It is a 3-step htmx wizard with stable ids
# (#applicationNumber, #newExpiry) and src/support.js drives those selectors
# directly — see WIZARD in that file. The four keys below are kept as an escape
# hatch for a redesign, and `npm run probe:support` still dumps the page so a
# change of shape gets noticed rather than silently mis-clicked. Leave blank.
SUPPORT_TRX_SELECTOR=
SUPPORT_DATE_SELECTOR=
SUPPORT_TIME_SELECTOR=
SUPPORT_SUBMIT_SELECTOR=

# Date format: SETTLED — the field is a native input[type=date], so it takes
# yyyy-mm-dd and nothing else, and there is no guessing left to do. There is also
# no time field: the tool preserves the time of day from the record's CURRENT
# expiry (measured; 21:10:17.357665 survived a move and a restore). Leave blank.
SUPPORT_DATE_FORMAT=

# --- mail (TS19 / REQ-009) ---------------------------------------------------
# The environment sends into MAILTRAP, sandbox `modefair` (2581833).
#
# TS19 PASSED on 26-08-2026 without any of these keys: Charmain read the sandbox
# in her own signed-in browser via MCP ("no need, just use mcp to check using my
# browser"). For one or two checks that is the route — no token to provision, no
# secret to store. Leave these blank unless a run must happen UNATTENDED.
#
# THE TOKEN DOES NOT BELONG HERE. Like every password, it lives in
# ~/.claude/secrets/eauto.env — one copy, no drift:
#
#   MAILTRAP_API_TOKEN=...        read access to the inbox
#   MAILTRAP_INBOX_ID=1234567
#   MAILTRAP_ACCOUNT_ID=987654    only needed by the newer API host
#
# Without them the TS19 assertions SKIP with a readable reason — they never pass
# quietly, because "no token" and "no email" must not look the same.
MAILTRAP_INBOX_ID=
MAILTRAP_ACCOUNT_ID=
MAILTRAP_API_TOKEN=

# =============================================================================
# The seven suites added 26-08-2026 evening
# =============================================================================
# Every scenario in the vault now has a script. These are the variables the new
# ones read. All optional: an unset one makes its case SKIP with a readable
# reason, never pass quietly.

# --- TS50: the Approved records with no registration-documents page ----------
# Fully read-only; needs nothing. Raise the sample to open more of them.
#   npm run test:population
EV_TS50_SAMPLE=

# --- TS51 / TS46: BackOffice-generated stubs (R19) ---------------------------
# NA68001100 is the reference stub and is the DEFAULT — you only set these to
# point at a different one. STUB_FOIL_APP_NO is the separate, spendable fixture
# the inertness half extends in order to prove the stub did not move; without it
# that half skips and TS51 only checks rendering, which is the easy half.
#   npm run test:stubs
STUB_APP_NO=
STUB_UUID=
STUB_FOIL_APP_NO=

# --- TS43 / TS34 / TS35 / TS29: the R14 two-surface sweep --------------------
# TS43, TS34 and TS29 each SPEND a pool fixture. TS35 is read-only and wants an
# already-extended record instead — it defaults to NA68001099.
#   npm run test:surfaces
FORMAT_APP_NO=

# --- TS54 / TS49: the window's upper bound -----------------------------------
# Patching an expiry never spends the extension (R1), so one record serves both
# cases and can be reused tomorrow. VPN required.
#
# TS54 asks which rule the upper bound follows — 90 days or 3 calendar months.
# It does NOT need the vault's two fixtures or its nine months: it patches
# WINDOW_APP_NO to an expiry that puts TODAY strictly between the two candidate
# closing days, so the two rules predict opposite things and one reading decides.
#
# TS49_APP_NO is only for the variant that uses a record ALREADY sitting on its
# closing day instead of patching one there.
#   EV_ALLOW_EXPIRY_PATCH=1 WINDOW_APP_NO=NA6800xxxx npm run test:window
WINDOW_APP_NO=
TS49_APP_NO=

# --- TS45 / TS52 / TS53: the server-side gate, past the button ---------------
# Every call is an EXPECTED REFUSAL, so on a correct build this costs nothing.
# The point is that the build might not refuse, and an accepted call is a real
# write on a real record (R1, unrecoverable) — hence the explicit opt-in and the
# insistence on throwaways. The suite refuses the known control fixtures by name.
#
# ENDPOINT_CONTROL_APP_NO is a SECOND throwaway and it WILL be spent: TS52
# variant D (a one-character remark) is expected to succeed, and TS53's HubAdmin
# control call has to succeed or the Probation refusal proves nothing.
#   EV_ALLOW_ENDPOINT_PROBE=1 ENDPOINT_APP_NO=NA6800xxxx npm run test:endpoint
EV_ALLOW_ENDPOINT_PROBE=
ENDPOINT_APP_NO=
ENDPOINT_CONTROL_APP_NO=

# --- TS38 / TS37 / TS40: a change under an open pop-up -----------------------
# TS38.1 patches the window shut while the modal is open (VPN + expiry patch).
# TS38.2 takes a pool fixture. TS38.3 is a census that asserts no status path
# exists, and needs only any Approved application to inspect.
#
# TS37 and TS40 are SEMI-MANUAL and TERMINAL. Registered is reachable only
# through Create Account, which the harness does not drive — so the script does
# everything else and then either watches the listing for Registered (TS37, up
# to 15 minutes) or counts down in the console (TS40) before driving the rest.
# Point them at fixtures you are finished with; Create Account cannot be undone.
#   EV_MANUAL_REGISTER=1 TS37_APP_NO=NA6800xxxx npm run test:midflight
TS38_STATUS_APP_NO=
EV_MANUAL_REGISTER=
TS37_APP_NO=
TS40_APP_NO=

# --- E2E_TS9 / TS55 / E2E_TS10: across the midnight cron ---------------------
# Two sittings. The evening leg patches the expiry to LATER TODAY (the support
# tool preserves the time of day, which is what makes the boundary land tonight),
# extends, and records its baseline into fixtures/overnight.json. The morning leg
# REFUSES to run without that file — "still Approved" is unfalsifiable when it
# was Approved yesterday too.
#
# OVERNIGHT_DEALER_LINK is what turns E2E_TS9 into E2E_TS9 + TS55 on one night:
# BackOffice in the morning is one half, the dealer's link is the other, and a
# half-applied extension hides precisely in the gap between them.
#
#   evening: EV_ALLOW_EXPIRY_PATCH=1 EV_ALLOW_WRITES=1 OVERNIGHT_APP_NO=NA... \
#            EV_OVERNIGHT=evening npm run test:overnight
#   morning: EV_OVERNIGHT=morning npm run test:overnight
EV_OVERNIGHT=
OVERNIGHT_APP_NO=
OVERNIGHT_DEALER_LINK=
E2E_TS10_APP_NO=

# --- the fixture pool --------------------------------------------------------
# EXTEND_APP_POOL is written by `npm run pool:build -- --write-env`.
#
# EV_POOL_EXCLUDE adds application numbers to the RESERVED set in src/pool.js,
# on top of the three already hard-coded there (NA68001099 the extended control,
# NA68001100 the R19 stub, NA62000987 the closing-day subject). This exists
# because EXTEND_APP_NO is folded into the pool as "a pool of one", and it had
# been left pointing at the already-extended control: take() handed it out and
# the test failed with "already extended", which is indistinguishable from the
# build wrongly greying a fresh record.
EV_POOL_EXCLUDE=

# ---------------------------------------------------------------------------
# EVIDENCE LEGS ADDED 27-08-2026 NIGHT — the four scenario families that were
# declared but undriven until then. Each variable feeds ONE trigger point, and
# every one of them REFUSES its point when unset rather than ticking on a guess.
# ---------------------------------------------------------------------------

# TS24 — page-remark. Seed the Application tab's own Remarks field with this text
# BEFORE the take, so the leg can prove the extension left it untouched. Without
# it the take proves only that the extension remark is absent from that field,
# which is the weaker half of Q8.
EV_PAGE_REMARK=

# TS33 — isolation. Another application belonging to the SAME dealer, plus the
# expiry you read off it before the take started. The baseline is what turns
# "it reads X" into "it did not move"; a value read once cannot say that.
EV_OTHER_APP_NO=
EV_OTHER_APP_EXPIRY=

# TS38 — revoked. Which arm this take is running. A and B expect OPPOSITE results
# (Q28): A = eligibility-breaking, refused with R10's verbatim message; B =
# harmless, must SUCCEED SILENTLY, and a refresh message there is the defect.
# A take that does not say which arm it ran cannot be read either way.
EV_MIDFLIGHT_ARM=

# TS16 / TS55 — the dealer side. The application link from the Pre-Application tab
# sidebar (Application Link > Copy Link). The recorder tries to read it off the
# page first and falls back to this. The CONTROL is an application BEYOND the
# 3-month window whose link must NOT load — without it, "the link works" is an
# absence with no positive control.
EV_DEALER_LINK=
EV_DEALER_LINK_CONTROL=

# TS14 / TS28 / TS39 / E2E_TS5 — the race. The SECOND account, which must be a
# different login with access to the same record. Two windows on one login is one
# session, and the race would prove nothing while looking perfect.
EV_ROLE_B=approver

# TS01.8 / TS37 / TS40 / E2E_TS10 — the Create Account hand-back. The leg stops the
# take and waits for a human, because the Hardcopy dropdown never offers Registered.
# EV_UNATTENDED=1 makes it refuse immediately instead of holding a cron run.
EV_HANDBACK_BUDGET_MS=480000
EV_HANDBACK_POLL_MS=5000
EV_UNATTENDED=
