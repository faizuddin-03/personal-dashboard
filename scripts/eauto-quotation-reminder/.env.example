# Injected by app/api/eauto-quotation-reminder/run/route.ts. Listed here so the
# suite can be run standalone for debugging.
QR_BASE_URL=https://staging.eauto.my/uat4
QR_UCD_USER=
QR_UCD_PASS=
QR_SUB_UCD_USER=
QR_SUB_UCD_PASS=
# The eSTM is created by hand today; give the run the vehicle it was created for.
QR_VEHICLE_NO=
QR_IC=
# now | before-hour | on-hour | at
QR_SCHEDULE_MODE=now
QR_SCHEDULE_AT=
QR_HEADLESS=
# Resolved by the run route from the signed-in modefair.com Chrome profile.
QR_CHROME_USER_DATA_DIR=
QR_CHROME_PROFILE_DIR=Default

# ── TS04 only — the case that creates an eSTM and buys ──
# TS04 drives scripts/eauto-estm to create its own eSTM on QR_VEHICLE_NO, then
# quotes with the IC that eSTM was created against (read from its BUYER_IC line,
# which overrides QR_IC). Set QR_CREATE_ESTM=0 if the vehicle already has one.
QR_CREATE_ESTM=1
# QR_ESTM_SCRIPT_DIR=../eauto-estm
# The eSTM login is the user patched to the bypass slot's IC — NOT the UCD under
# test. Blank falls through to the eSTM suite's own defaults.
# QR_ESTM_USERNAME=
# QR_ESTM_PASSWORD=
# QR_ESTM_BYPASS_SLOT=
# The eSTM BUYER email (#buyerEmail). Must NOT be faizuddin@modefair.com —
# that is the fixed eVOC address and the portal rejects the form when they
# match. Normally supplied by the quotation-reminder page.
QR_ESTM_BUYER_EMAIL=faizbidi03@gmail.com
QR_ESTM_MOBILE=0123456789
# Add-ons cost real money (eLKM ~RM200, eVOC RM10) and TS04 needs neither.
QR_ESTM_ELKM=0
QR_ESTM_EVOC=0
# Seconds to idle at step 3 before returning to the listing to pay.
# TS04 as written says 5 minutes — set 300 for a real run. The default of 10 is
# there so the script can be proved end to end quickly.
QR_DROP_OFF_SECONDS=10

# Cron cadence. Production runs hourly (default 60). For testing, the team
# runs it every 10 minutes so a scenario doesn't take hours to prove out.
QR_CRON_INTERVAL_MINUTES=60
# QR_CRON_FIRST_HOUR=7
# QR_CRON_LAST_HOUR=23

# TS06 only — drives scripts/eauto-esim (untouched) to force the 69E redirect.
# Requires the VPN. Blank falls back to eSIM's own default (admin/admin).
# QR_ESIM_SCRIPT_DIR=../eauto-esim
# QR_ESIM_USER=
# QR_ESIM_PASS=
