# eAuto AATF eDereg Pre-Checking Enquiry automation — environment variables
# Copy to .env (git-ignored) or let the dashboard inject these at runtime.

# Confirmed by Faizuddin, 2026-08-21 — this ticket's automation runs on uat1.
DPC_ENV_SEGMENT=uat1
DPC_VEHICLE_REG_NO=
DPC_JPJ_RECEIPT_EMAIL=
# Blank falls back to faizuddinAATF / password (default AATF test account,
# confirmed by Faizuddin 2026-08-21).
DPC_USERNAME=
DPC_PASSWORD=
# The dashboard runner sets this so the run doesn't pause at the end.
DPC_SKIP_PAUSE=1
