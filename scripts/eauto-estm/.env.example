# eAuto eSTM (eSERAHAN) automation — environment variables
# Copy to .env (git-ignored) or let the dashboard inject these at runtime.
# Env segment, vehicle reg no, email, and mobile are required.

ESTM_ENV_SEGMENT=sit3
ESTM_VEHICLE_REG_NO=
ESTM_EMAIL_ADDRESS=
ESTM_MOBILE_NO=
# Blank falls back to faizuddinsub2 / password.
# The login and ESTM_BYPASS_SLOT are ONE setting — each slot is bound to an IC
# and the login user must be patched to it, or step 3 blocks with
# "Please use login user's mykad". Change both together.
ESTM_USERNAME=
ESTM_PASSWORD=
# Blank falls back to zzz/22, the shared slot patched to the OLD default login
# (nsub2abc). Set this to whichever slot the username above is patched to.
ESTM_BYPASS_SLOT=
# Payment-step add-ons. UNSET means ON (matching the portal, which ticks both
# on load). "0" is the only off value.
#   eLKM  +RM200 + RM2.75 fee, needs active insurance on the vehicle
#   eVOC  +RM10 fee
ESTM_ELKM=
ESTM_EVOC=
ESTM_ID_TYPE=1
ESTM_EVOC_EMAIL=
# The dashboard runner sets this so the run doesn't pause at the end.
ESTM_SKIP_PAUSE=1
