# eAuto eSTM (eSERAHAN) automation — environment variables
# Copy to .env (git-ignored) or let the dashboard inject these at runtime.
# Env segment, vehicle reg no, email, and mobile are required.

ESTM_ENV_SEGMENT=sit3
ESTM_VEHICLE_REG_NO=
ESTM_EMAIL_ADDRESS=
ESTM_MOBILE_NO=
ESTM_USERNAME=
ESTM_PASSWORD=
ESTM_ID_TYPE=1
ESTM_EVOC_EMAIL=
# The dashboard runner sets this so the run doesn't pause at the end.
ESTM_SKIP_PAUSE=1
