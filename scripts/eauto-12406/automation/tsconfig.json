{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@playwright/test": ["node_modules/@playwright/test"],
      "@fixtures": ["src/fixtures/test.ts"],
      "@fixtures/*": ["src/fixtures/*"],
      "@pages/*": ["src/pages/*"],
      "@auth/*": ["src/auth/*"],
      "@data/*": ["src/data/*"],
      "@utils/*": ["src/utils/*"],
      "@config/*": ["config/*"],
      "@flows/*": ["src/flows/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "config/**/*.ts", "playwright.config.ts", "../cr/*/03-spec/**/*.ts"],
  "exclude": ["node_modules", ".artifacts", "test-results", "playwright-report"]
}
