# eAuto UCD Insurance E2E — environment variables
# Copy to .env (git-ignored) or let the dashboard inject these at runtime.
# VEHICLE NO and IC are required; everything else has a staging fallback.

E2E_ENV=sit3
E2E_USERNAME=
E2E_PASSWORD=
E2E_VEHICLE_NO=
E2E_IC=
E2E_CATEGORY=individual
E2E_EMAIL=
E2E_INSURER=first
E2E_COVERAGE=random
E2E_SUM=default
E2E_BANK=random
# Set to 1 for a safe dry run: stops before PAY NOW, creates no transaction.
E2E_STOP_BEFORE_PAYMENT=0
