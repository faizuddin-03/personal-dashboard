# EAINT-12153 — UCD onboarding payment channels (Pre-application/Application)
# Copy to .env.local (or export directly) before running. The dashboard's
# eventual run route will inject these the same way scripts/eauto-company-checker
# does; until that route exists, run `npx playwright test` directly from this
# folder with these set.

# eAuto environment under test — the whole onboarding flow (Pre-Application,
# Application, payment step) plus the BO side all live under this base URL.
EAUTO_BASE_URL=https://staging.eauto.my/sit3

# BO accounts used by the Continuation Steps (BO side of every TS3-8 flow).
# Two DISTINCT named accounts per the test sheet — mfared assigns the UCD
# group + submits for approval + verifies registration documents; jasons
# approves the BO Application form. Not interchangeable.
EAUTO_BO_MFARED_USERNAME=mfared
EAUTO_BO_MFARED_PASSWORD=password
EAUTO_BO_JASONS_USERNAME=jasons
EAUTO_BO_JASONS_PASSWORD=password

# FPX sandbox bank login — same convention as scripts/secarang-insurance's
# REGRESSION.bankUsername/bankPassword. Only relevant to TS3/TS4 (FPX B2C).
EAUTO_FPX_BANK_USERNAME=
EAUTO_FPX_BANK_PASSWORD=

# Card sandbox test cards — see the test sheet's own Notes section (Fiuu vs
# Razorpay unconfirmed as of 2026-09-01). Only relevant to TS5/TS6 (Card).
EAUTO_CARD_VISA_NUMBER=4111111111111111
EAUTO_CARD_VISA_CVV=111
EAUTO_CARD_MASTERCARD_NUMBER=5105105105105100
EAUTO_CARD_MASTERCARD_CVV=444

# Recipient email for invoice/e-invoice checks and BO "Admin in Charge" field.
EAUTO_ONBOARDING_EMAIL=faizuddin@modefair.com
