# Secarang Insurance automation — environment variables
# Copy to .env (git-ignored) or let the dashboard inject these at runtime.
# All values are optional; staging fallbacks exist in data/.

SECARANG_BASE_URL=https://staging.secarang.com/preprod
SECARANG_SITE_PASSWORD=
SECARANG_POSTCODE=55000
SECARANG_IC=
SECARANG_CONCURRENCY=1
SECARANG_CHECK_VEHICLE_DETAILS=1

# Regression run (Zurich E2E)
REGRESSION_VN=
REGRESSION_IC=
REGRESSION_POSTCODE=
REGRESSION_INSURER=Zurich
REGRESSION_COVERAGE_TYPE=comprehensive
REGRESSION_QUOTATION_POSTCODE=
REGRESSION_SUM_INSURED=default
REGRESSION_VEHICLE_TYPE=car
REGRESSION_OWNER_TYPE=private
REGRESSION_ADDONS=
REGRESSION_NAME=
REGRESSION_EMAIL=
REGRESSION_PHONE=
REGRESSION_ADDR1=
REGRESSION_ADDR2=
REGRESSION_ADDR3=
REGRESSION_DISCOUNT=
REGRESSION_BANK=fpx_mb2u
REGRESSION_BANK_USER=
REGRESSION_BANK_PASS=
REGRESSION_PAYMENT_STATUS=00
