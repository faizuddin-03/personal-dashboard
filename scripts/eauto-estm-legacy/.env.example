# eAuto eSTM (eSERAHAN) automation — environment variables
# Copy to .env (git-ignored) or let the dashboard inject these at runtime.
# Env segment, vehicle reg no, email, and mobile are required.

ESTM_ENV_SEGMENT=sit3
ESTM_VEHICLE_REG_NO=
ESTM_EMAIL_ADDRESS=
ESTM_MOBILE_NO=
# The SCRIPT's own fallback is still the old nsub2abc / abcd1234 — it is a
# verbatim copy and must not be edited. The dashboard route injects the current
# default (faizuddinsub2 / password) instead, so a run started from
# /eauto/estm-legacy matches /eauto/estm. Running this suite by hand does NOT:
# set these explicitly.
ESTM_USERNAME=
ESTM_PASSWORD=
ESTM_ID_TYPE=1
# Not read by this script — the eVOC address is hardcoded to
# nicholas.lim@modefair.com. Left here only so the two files line up.
ESTM_EVOC_EMAIL=
# The dashboard runner sets this so the run doesn't pause at the end.
ESTM_SKIP_PAUSE=1
