NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://wbs:wbs_dev@localhost:5432/wbs
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-me-in-prod
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
CORS_ORIGIN=http://localhost:5173

# WhatsApp Cloud API (Meta) - leave WHATSAPP_MOCK_MODE=true until you have real credentials
WHATSAPP_MOCK_MODE=true
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# LLM provider: mock (default, deterministic offline stub) | ollama
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPLATE_MODEL=qwen3:14b
OLLAMA_TIMEOUT_MS=60000

# Send-time advisor (Best time to resend on completed campaigns)
SEND_TIME_LOOKBACK_DAYS=90        # how far back to gather read/reply history
SEND_TIME_MIN_EVENTS=30           # below this many engagement events → cold-start, no recommendation
OLLAMA_INSIGHT_MODEL=             # optional; defaults to OLLAMA_TEMPLATE_MODEL

# --- Blast assistant (NL → template + scheduled campaign) ---
# Uses Ollama native tool-calling, so it requires LLM_PROVIDER=ollama and a tool-capable model.
# Reuses OLLAMA_BASE_URL / OLLAMA_TIMEOUT_MS above; optionally a distinct model for the agent:
OLLAMA_ASSISTANT_MODEL=qwen3:14b
# Staged-plan time-to-live before it expires and must be re-proposed (ms; default 30 min):
ASSISTANT_PLAN_TTL_MS=1800000
# Fire-time guard for campaigns scheduled against a not-yet-approved (PENDING) template:
#   how often the worker re-checks approval while holding (ms; default 5 min):
ASSISTANT_TEMPLATE_RECHECK_MS=300000
#   how long to keep holding before failing the blast (ms; default 24 h):
ASSISTANT_TEMPLATE_GRACE_MS=86400000

# Phase 4: Blast engine
MESSAGES_PER_SECOND=80
REPLY_ATTRIBUTION_WINDOW_DAYS=7

# Phase 6: Rate limiting — set to 5 (login) / 10 (refresh) in production.
# Use a high value locally so E2E tests don't exhaust the limit.
THROTTLE_GLOBAL_LIMIT=1000


#AI Chatbot
# Chatbot master switch — default OFF until Session 14 soak test passes
CHATBOT_ENABLED=true

# Kill switch — flip true during incidents; every decision becomes ESCALATE
CHATBOT_DISABLE_AUTO_REPLY=false

# Decision tuning
CHATBOT_CONFIDENCE_THRESHOLD=0.85
# Anchor drafter confidence to source coverage, decoupled from reply-language/translation difficulty.
# Reduces false BM escalations BUT also auto-sends confident-wrong answers where retrieval is
# imprecise (e.g. NCD-class) — keep OFF until a faithfulness/grounding backstop exists.
CHATBOT_CONFIDENCE_DECOUPLE_LANG=false
CHATBOT_BUSINESS_HOURS_START=09:00
CHATBOT_BUSINESS_HOURS_END=18:00
CHATBOT_BUSINESS_HOURS_TIMEZONE=Asia/Kuala_Lumpur
CHATBOT_BUSINESS_DAYS=MON,TUE,WED,THU,FRI
CHATBOT_ESCALATION_PHONE=+60123456789

# Retrieval tuning
CHATBOT_RETRIEVAL_TOP_K=5             # how many chunks to retrieve per query
CHATBOT_RETRIEVAL_MIN_SCORE=0.5       # minimum cosine similarity to consider a chunk relevant
CHATBOT_CHUNK_SIZE_TOKENS=500         # target chunk size when ingesting documents
CHATBOT_CHUNK_OVERLAP_TOKENS=50       # token overlap between adjacent chunks

# Relevance reranking (LLM-judge between retrieval and the drafter). OFF by default.
# When ON, retrieval fetches CHATBOT_RERANK_CANDIDATE_K candidates and an LLM-judge reorders them by
# which actually ANSWER the question, handing the top CHATBOT_RERANK_TOP_N to the drafter. Surfaces
# the answer chunk past term-dense walls (e.g. NCD-on-claim) and is the prerequisite for safely
# enabling CHATBOT_CONFIDENCE_DECOUPLE_LANG. Adds one fast LLM call per answered query.
CHATBOT_RERANK_ENABLED=false
CHATBOT_RERANK_CANDIDATE_K=20         # candidates fetched before reranking
CHATBOT_RERANK_TOP_N=5                # chunks handed to the drafter after reranking

# Resolution capture (close-ticket flow)
CHATBOT_CAPTURE_DEDUP_THRESHOLD=0.85       # cosine similarity above which a captured doc is treated as duplicate of existing LIVE
# (the BullMQ queue name "chatbot-resolution-capture" is a constant in code, not an env var)

# LLM (chat completion) — Ollama only
LLM_MOCK_MODE=false
LLM_OLLAMA_URL=http://localhost:11434/v1
LLM_OLLAMA_CHAT_MODEL=qwen2.5:14b                  # MacBook dev. On Mac Studio production: qwen3.5:4b (or llama3.3:70b on 96 GB+)
LLM_OLLAMA_TIMEOUT_MS=15000                       # MacBook dev. On Mac Studio production: 15000 (faster per-token throughput)

# Embeddings — Ollama-hosted bge-m3 (1024-dim, multilingual)
EMBEDDINGS_MOCK_MODE=false
EMBEDDINGS_PRIMARY=ollama                         # "ollama" (default) or "openai" (fallback for memory-pressure days on MacBook)
EMBEDDINGS_OLLAMA_URL=http://localhost:11434/v1
EMBEDDINGS_OLLAMA_MODEL=bge-m3
EMBEDDINGS_OLLAMA_TIMEOUT_MS=10000

# Optional OpenAI fallback (recommended on MacBook dev for memory headroom; not required on Mac Studio)
EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
EMBEDDINGS_OPENAI_DIMENSIONS=1024
OPENAI_API_KEY=                        # optional; required only if EMBEDDINGS_PRIMARY=openai or for fallback

EMBEDDINGS_VECTOR_DIM=1024             # MUST match what the chosen model outputs; do NOT change after first ingestion

# QA simulator (dev only). Off by default. Requires WHATSAPP_MOCK_MODE=true to operate.
SIMULATOR_ENABLED=false
